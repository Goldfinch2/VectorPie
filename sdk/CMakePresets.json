{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "pc",
      "displayName": "PC: Windows .exe (MinGW-w64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-pc",
      "toolchainFile": "${sourceDir}/cmake/toolchain-mingw-w64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SDL2_DIR": "/opt/sdl2-mingw/cmake",
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/VectorPie/dist/pc"
      }
    },
    {
      "name": "pi",
      "displayName": "Pi: Linux arm64 (Debian trixie)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-pi",
      "toolchainFile": "${sourceDir}/cmake/toolchain-pi-arm64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/VectorPie/dist/pi"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux x86_64 (WSL2 Debian, a window through WSLg): testing on the PC",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "$env{HOME}/VectorPie/dist/linux"
      }
    }
  ],
  "buildPresets": [
    { "name": "pc", "configurePreset": "pc" },
    { "name": "pi", "configurePreset": "pi" },
    { "name": "linux", "configurePreset": "linux" }
  ]
}
